generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id String @id @default(uuid()) 
  email String @unique
  name String
  createdAt DateTime @default(now())
  claims Claim[]
}

model Claim {
  id Int @id @default(autoincrement())
  userId String
  text String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  result ClaimResult?

}

enum Verdict {
  FAKE
  LEGIT
  UNCERTAIN
}

model ClaimResult {
  id Int @id @default(autoincrement())
  claimId Int @unique
  verdict Verdict
  analysis String
  confidence Int
  createdAt DateTime @default(now())

  claim Claim @relation(fields: [claimId], references:  [id])
  
}